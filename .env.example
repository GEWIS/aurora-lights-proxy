# Required
URL=http://localhost:3000
API_KEY=

# Optional -- log filter (trace, debug, info, warn, error). Accepts EnvFilter directives.
LOG_LEVEL=info

# Optional -- Art-Net controller IP. Defaults to 169.254.0.2.
# TARGET_IP=169.254.0.2

# Optional -- DMX universe (0-32767). Defaults to 0.
# UNIVERSE=0

# Optional -- bytes per Art-Net frame (2-512, must be even). Defaults to 512.
# PACKET_SIZE=512

# Optional -- Art-Net send rate in frames per second. Defaults to 40.
# FPS=40
